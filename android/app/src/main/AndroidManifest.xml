<?xml version="1.0" encoding="utf-8"?>
<!-- Merge the relevant bits into your generated AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ads need network access. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Skydoku"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- Skydoku AdMob application id (from the AdMob console). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5816871059908402~2130478466" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
