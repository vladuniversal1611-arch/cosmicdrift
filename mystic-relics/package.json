{
  "name": "mystic-relics",
  "version": "1.0.0",
  "description": "Mystic Relics — original HTML5 tile-matching puzzle (pure HTML/CSS/Vanilla JS/Canvas/WebAudio).",
  "private": true,
  "scripts": {
    "cap:web": "node scripts/copy-web.js",
    "cap:add": "npm run cap:web && npx cap add android",
    "cap:clean": "node -e \"const fs=require('fs'),p='android/app/src/main/assets/public';fs.existsSync(p)&&fs.rmSync(p,{recursive:true,force:true});console.log('Android public assets cleaned')\"",
    "cap:sync": "npm run cap:web && npm run cap:clean && npx cap sync",
    "cap:open": "npx cap open android",
    "assets": "npx capacitor-assets generate --android --iconBackgroundColor '#0d0a1f' --splashBackgroundColor '#0d0a1f'",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "build:apk": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@revenuecat/purchases-capacitor": "^9.2.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0"
  }
}
