{
  "name": "mystic-relics",
  "version": "1.0.0",
  "description": "Mystic Relics — original HTML5 tile-matching puzzle (pure HTML/CSS/Vanilla JS/Canvas/WebAudio).",
  "private": true,
  "scripts": {
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "assets": "npx capacitor-assets generate --android --iconBackgroundColor '#0d0a1f' --splashBackgroundColor '#0d0a1f'",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "build:apk": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0"
  }
}
