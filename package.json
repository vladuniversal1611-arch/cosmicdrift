{
  "name": "weeknote",
  "version": "1.0.0",
  "description": "WeekNote — weekly planner Android app (Capacitor + AdMob)",
  "private": true,
  "scripts": {
    "prepare-www": "node scripts/build-www.js",
    "postinstall": "npm run prepare-www && node scripts/setup-android.js",
    "sync": "npm run prepare-www && cap sync",
    "android": "cap open android",
    "build": "npm run sync && cap open android",
    "clean": "rimraf www android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor-community/admob": "^8.1.0"
  }
}
