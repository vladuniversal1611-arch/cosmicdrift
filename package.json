{
  "name": "mystic-alchemy-lab",
  "version": "1.0.0",
  "description": "A bright, relaxing alchemy fusion puzzle. Restore an ancient floating laboratory across 320 handcrafted levels. Offline, no ads, no tracking.",
  "private": true,
  "scripts": {
    "start": "npx serve .",
    "add:android": "npx cap add android",
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "build:apk": "cd android && ./gradlew assembleDebug"
  },
  "keywords": ["game", "puzzle", "alchemy", "casual", "html5", "capacitor", "offline"],
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  }
}
